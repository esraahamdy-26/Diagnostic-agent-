{
  "model_name": "diabetes_risk_screening",
  "task": "Pre-lab diabetes risk screening (non-circular): predicts likelihood of an abnormal glucose/HbA1c BEFORE the test is done, using only reportable risk factors",
  "input": {
    "type": "object",
    "required": [
      "age",
      "bmi",
      "systolic_bp",
      "diastolic_bp",
      "total_cholesterol",
      "sex"
    ],
    "properties": {
      "age": {
        "type": "number"
      },
      "bmi": {
        "type": "number"
      },
      "systolic_bp": {
        "type": "number"
      },
      "diastolic_bp": {
        "type": "number"
      },
      "total_cholesterol": {
        "type": "number"
      },
      "sex": {
        "type": "string",
        "enum": [
          "male",
          "female"
        ]
      }
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "prediction": {
        "type": "string",
        "enum": [
          "low_risk",
          "elevated_risk"
        ]
      },
      "risk_score": {
        "type": "number"
      },
      "triage_action": {
        "type": "string",
        "enum": [
          "reassure_and_explain",
          "ask_follow_up_questions"
        ]
      },
      "explanation": {
        "type": "string"
      },
      "safety_disclaimer": {
        "type": "string"
      }
    }
  }
}